{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "易界 AI",
  "version": "0.1.0",
  "identifier": "com.yijie.ai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "易界 AI",
        "width": 1180,
        "height": 780,
        "minWidth": 1180,
        "minHeight": 760
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:8080 http://127.0.0.1:8080 http://localhost:18080 http://127.0.0.1:18080 ws://localhost:1421 ws://127.0.0.1:1421",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: yijie-artifact-preview:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
