{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NativeConversationViewV3",
  "$ref": "#/definitions/NativeConversationViewEvent",
  "definitions": {
    "NativeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "availability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 512
        },
        "type": {
          "type": "string",
          "enum": [
            "userMessage",
            "agentMessage",
            "reasoning",
            "commandExecution",
            "mcpToolCall",
            "webSearch",
            "fileChange",
            "subAgentActivity",
            "imageView",
            "unknown",
            "unpublishedText"
          ]
        },
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 1048576
        },
        "phase": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "commentary",
                "final_answer"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 1048576
          }
        },
        "content": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 1048576
          }
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "inProgress",
                "completed",
                "failed",
                "declined"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer",
              "format": "int32"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "anyOf": [
            {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "argumentsSummary": {
          "type": "string",
          "maxLength": 4096,
          "description": "Metadata display only; raw native arguments never leave Host. For yijie_web/kimi_web_search_pro this may contain the validated, displayable query alone."
        },
        "resultSummary": {
          "type": "string",
          "maxLength": 8192,
          "description": "Metadata display only, omitted when native result is absent or null."
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "unavailable"
          ],
          "description": "Completeness of this safe display projection, independent of the native execution status."
        },
        "commandLabel": {
          "type": "string",
          "maxLength": 8192,
          "description": "Security projection label, not the original command. No execution semantics are inferred."
        },
        "cwdLabel": {
          "type": "string",
          "maxLength": 1024,
          "description": "Workspace-relative display label; never the native absolute path."
        },
        "outputText": {
          "type": "string",
          "maxLength": 1048576,
          "description": "Bounded, redacted projection of native aggregatedOutput. Omitted when native output is null or unavailable."
        },
        "toolLabel": {
          "type": "string",
          "maxLength": 256,
          "description": "Safe display label, not a registered tool identifier. Tool registration is outside FEAT-132."
        },
        "mcp": {
          "$ref": "#/definitions/NativeMcpDisplay"
        },
        "webSearch": {
          "$ref": "#/definitions/NativeWebSearchDisplay"
        },
        "commandActions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/NativeCommandActionDisplay"
          }
        },
        "toolDisplay": {
          "$ref": "#/definitions/NativeToolDisplay"
        },
        "publication": {
          "$ref": "#/definitions/NativeMessagePublication"
        }
      }
    },
    "NativeTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "items",
        "itemsComplete"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 512
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "inProgress",
                "completed",
                "interrupted",
                "failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "type": "string",
          "maxLength": 128,
          "description": "Safe diagnostic category for a native error; not the raw error payload. Native status is preserved separately."
        },
        "items": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/definitions/NativeItem"
          }
        },
        "itemsComplete": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/definitions/NativeError"
        }
      }
    },
    "NativePlanStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "status"
      ],
      "properties": {
        "step": {
          "type": "string",
          "maxLength": 65536
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "inProgress",
            "completed"
          ]
        }
      }
    },
    "NativeNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "method",
        "threadId",
        "availability"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "runtime_notification",
            "projection_notice"
          ]
        },
        "method": {
          "type": "string",
          "maxLength": 128
        },
        "threadId": {
          "type": "string",
          "maxLength": 512
        },
        "turnId": {
          "type": "string",
          "maxLength": 512
        },
        "itemId": {
          "type": "string",
          "maxLength": 512
        },
        "item": {
          "$ref": "#/definitions/NativeItem"
        },
        "turn": {
          "$ref": "#/definitions/NativeTurn"
        },
        "delta": {
          "type": "string",
          "maxLength": 1048576
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "plan": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/definitions/NativePlanStep"
          }
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string",
          "maxLength": 128
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "willRetry": {
          "anyOf": [
            {
              "type": "boolean",
              "description": "Native retry intent only. Omitted/null means unknown, never false; does not drive client execution."
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "NativeThreadSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "thread_id",
        "turns",
        "availability"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [
            6
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "runtime_read",
            "runtime_resume"
          ]
        },
        "thread_id": {
          "type": "string",
          "maxLength": 512
        },
        "turns": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/definitions/NativeTurn"
          }
        },
        "availability": {
          "type": "string",
          "enum": [
            "partial",
            "unavailable"
          ]
        }
      }
    },
    "NativeEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "stream_id",
        "sequence",
        "occurred_at",
        "task_id",
        "agent_session_id",
        "codex_thread_id",
        "event_type",
        "terminal",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [
            13
          ]
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "stream_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "agent_session_id": {
          "type": "string",
          "format": "uuid"
        },
        "codex_thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": "string",
          "maxLength": 512
        },
        "item_id": {
          "type": "string",
          "maxLength": 512
        },
        "event_type": {
          "type": "string",
          "enum": [
            "native.notification"
          ]
        },
        "terminal": {
          "type": "boolean"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "native"
          ],
          "properties": {
            "native": {
              "$ref": "#/definitions/NativeNotification"
            }
          }
        }
      }
    },
    "NativeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability"
      ],
      "properties": {
        "availability": {
          "type": "string",
          "enum": [
            "partial",
            "unavailable"
          ]
        },
        "messageText": {
          "type": "string",
          "maxLength": 4096,
          "description": "Bounded redacted native message, not an inferred execution result."
        },
        "codexErrorInfo": {
          "type": "string",
          "enum": [
            "contextWindowExceeded",
            "sessionBudgetExceeded",
            "usageLimitExceeded",
            "serverOverloaded",
            "cyberPolicy",
            "httpConnectionFailed",
            "responseStreamConnectionFailed",
            "internalServerError",
            "unauthorized",
            "badRequest",
            "threadRollbackFailed",
            "sandboxError",
            "responseStreamDisconnected",
            "responseTooManyFailedAttempts",
            "activeTurnNotSteerable",
            "other"
          ],
          "description": "Allowlisted native discriminator. Unknown native details are omitted."
        }
      }
    },
    "NativeMcpText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "text"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31,
          "description": "Original native content array index; never renumber after filtering."
        },
        "text": {
          "type": "string",
          "maxLength": 262144,
          "description": "Plain text after confidentiality projection and UTF-8 truncation. At index 0, built-in deep search may project SearchSuccess (title, url and snippet) or a validated public retrieval error. For newly observed results, url preserves the public HTTP(S) article address permitted by the native source URL policy, falling back to its displayable origin when necessary. Existing site-only receipts retain their origin. Desktop may open an exact result URL after user activation and independent native history authorization."
        }
      }
    },
    "NativeMcpDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultKind",
        "texts",
        "diagnostics"
      ],
      "description": "Display-only native MCP facts. No raw arguments/error/meta/resources/structuredContent and no business field parsing. Native list_mcp_resources/list_mcp_resource_templates may expose a validated resource count and redacted resource names/titles, never resource URIs, cursors or metadata. Empty resource lists are successful real results, not omitted content. For yijie_web/kimi_web_search_pro only, Host validates the closed built-in web result and projects the ordered source summaries from its native text block. Raw page content and chunks are excluded. Other tools retain their existing display policies. Limits do not change execution status; partial content availability must not suppress a known execution outcome. Host bounds total UTF-8 text at 256KiB and first 32 original content entries. Confidentiality may replace entire lines.",
      "properties": {
        "server": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "tool": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "resultKind": {
          "type": "string",
          "enum": [
            "absent",
            "null",
            "empty",
            "text",
            "unsupported",
            "omitted"
          ]
        },
        "texts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/NativeMcpText"
          }
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "identity_unavailable",
              "arguments_unavailable",
              "unsupported_content",
              "content_redacted",
              "content_truncated",
              "content_limit",
              "result_unavailable",
              "display_limit"
            ]
          }
        },
        "searchReceipt": {
          "$ref": "#/definitions/DeepSearchReceipt"
        }
      }
    },
    "NativeThreadStatusSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "description": "Current thread/read(includeTurns=false) status only. This ephemeral observation has no history watermark and must not change saved Item or Turn facts, infer their completion, or be persisted as a history format.",
      "required": [
        "schema_version",
        "source",
        "thread_id",
        "status"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [
            2
          ],
          "x-enum-varnames": [
            "NativeThreadStatusSnapshotSchemaVersionN2"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "runtime_read"
          ],
          "x-enum-varnames": [
            "NativeThreadStatusSnapshotSourceRuntimeRead"
          ]
        },
        "thread_id": {
          "type": "string",
          "maxLength": 512
        },
        "status": {
          "type": "string",
          "enum": [
            "notLoaded",
            "idle",
            "systemError",
            "active"
          ],
          "x-enum-varnames": [
            "NativeThreadStatusSnapshotStatusNotLoaded",
            "NativeThreadStatusSnapshotStatusIdle",
            "NativeThreadStatusSnapshotStatusSystemError",
            "NativeThreadStatusSnapshotStatusActive"
          ],
          "description": "Exact native thread.status.type. active remains active even when historical Turns appear completed; idle is not inferred from Turn status. notLoaded and systemError do not prove readiness or grant permission."
        }
      }
    },
    "NativeWebSearchDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "queries"
      ],
      "description": "Safe display of the native WebSearchAction only. No execution or lifecycle inference. Queries/pattern are bounded and redacted; pageLabel is a hostname only, never an actionable URL. Optional sources are actual search hits, never inferred citations. Absence means no source metadata observed.",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "search",
            "openPage",
            "findInPage",
            "other"
          ]
        },
        "queries": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "pageLabel": {
          "type": "string",
          "maxLength": 253
        },
        "pattern": {
          "type": "string",
          "maxLength": 1024
        },
        "sources": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/NativeWebSearchSourceDisplay"
          }
        }
      }
    },
    "NativeWebSearchSourceDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "description": "Actual provider search hit. Inert text only; not a verified citation or executable link. URL must be safe HTTP(S), no credentials, bounded and redacted; unsafe entries are omitted with partial availability.",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://"
        },
        "title": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "NativeCommandActionDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "kind"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "listFiles",
            "search",
            "unknown"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 512
        },
        "query": {
          "type": "string",
          "maxLength": 256
        }
      },
      "description": "Safe projection of the original native command action. Index identifies a display action under its parent Item, not an independent execution."
    },
    "NativeToolDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance"
      ],
      "properties": {
        "provenance": {
          "type": "string",
          "enum": [
            "nativeAppContext",
            "registeredTool",
            "allowedTitle"
          ]
        },
        "sourceLabel": {
          "type": "string",
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "maxLength": 160
        }
      },
      "description": "Safe display labels only. Never tool identity, authority, raw arguments or arbitrary metadata."
    },
    "DeepSearchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "relation": {
          "type": "string",
          "enum": [
            "first",
            "joined",
            "reused"
          ],
          "x-enum-varnames": [
            "SearchRelationFirst",
            "SearchRelationJoined",
            "SearchRelationReused"
          ]
        },
        "dispatch": {
          "type": "string",
          "enum": [
            "not_dispatched",
            "uncertain",
            "attempted",
            "responded"
          ],
          "x-enum-varnames": [
            "SearchDispatchNotDispatched",
            "SearchDispatchUncertain",
            "SearchDispatchAttempted",
            "SearchDispatchResponded"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "pending",
            "results",
            "empty",
            "partial",
            "failed",
            "unknown"
          ],
          "x-enum-varnames": [
            "SearchOutcomePending",
            "SearchOutcomeResults",
            "SearchOutcomeEmpty",
            "SearchOutcomePartial",
            "SearchOutcomeFailed",
            "SearchOutcomeUnknown"
          ]
        },
        "availability": {
          "type": "string",
          "enum": [
            "pending",
            "available",
            "unavailable"
          ],
          "x-enum-varnames": [
            "SearchAvailabilityPending",
            "SearchAvailabilityAvailable",
            "SearchAvailabilityUnavailable"
          ]
        },
        "error_code": {
          "type": "string",
          "enum": [
            "invalid_arguments",
            "session_expired",
            "not_entitled",
            "quota_exceeded",
            "busy",
            "upstream_unavailable",
            "timeout",
            "no_content",
            "response_too_large",
            "invalid_response",
            "cancelled",
            "outcome_unknown",
            "operation_conflict",
            "operation_expired",
            "result_unavailable"
          ],
          "x-enum-varnames": [
            "SearchErrorCodeInvalidArguments",
            "SearchErrorCodeSessionExpired",
            "SearchErrorCodeNotEntitled",
            "SearchErrorCodeQuotaExceeded",
            "SearchErrorCodeBusy",
            "SearchErrorCodeUpstreamUnavailable",
            "SearchErrorCodeTimeout",
            "SearchErrorCodeNoContent",
            "SearchErrorCodeResponseTooLarge",
            "SearchErrorCodeInvalidResponse",
            "SearchErrorCodeCancelled",
            "SearchErrorCodeOutcomeUnknown",
            "SearchErrorCodeOperationConflict",
            "SearchErrorCodeOperationExpired",
            "SearchErrorCodeResultUnavailable"
          ]
        }
      },
      "required": [
        "version",
        "relation",
        "dispatch",
        "outcome",
        "availability"
      ]
    },
    "NativeMessagePublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "order",
        "source",
        "truncated"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "afterItemId": {
          "type": "string",
          "maxLength": 512
        },
        "source": {
          "type": "string",
          "enum": [
            "provider",
            "declaration",
            "subsequent_work",
            "turn_commit",
            "progress_step",
            "final_step",
            "interrupted",
            "failed",
            "superseded",
            "display_limit"
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "description": "Published by the negotiated Runtime. order is the original turn observation order. afterItemId anchors a delayed message. Undelivered text is never an agentMessage or an execution terminal."
    },
    "NativeDisplayItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "$ref": "#/definitions/NativeItem"
        },
        "lastMethod": {
          "type": "string",
          "enum": [
            "item/started",
            "item/completed",
            "thread/read"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "item",
        "lastMethod",
        "ordinal"
      ]
    },
    "NativeViewCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streamId": {
          "type": "string"
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "eventId": {
          "type": "string"
        }
      },
      "required": [
        "streamId",
        "sequence",
        "eventId"
      ]
    },
    "NativeConversationView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        },
        "runtimeThreadId": {
          "type": "string"
        },
        "runtimeTurnId": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "native_observed",
            "native_rebuilt",
            "legacy_archive"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "inProgress",
                "completed",
                "interrupted",
                "failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "terminalObserved": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NativeDisplayItem"
          },
          "maxItems": 512
        },
        "plan": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NativePlanStep"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/NativeViewCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminalErrorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "statusSource": {
          "type": "string",
          "enum": [
            "runtime_notification",
            "runtime_read"
          ]
        },
        "notices": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/NativeTraceNotice"
          }
        }
      },
      "required": [
        "sessionId",
        "turnId",
        "runtimeThreadId",
        "runtimeTurnId",
        "source",
        "revision",
        "availability",
        "terminalObserved",
        "items"
      ]
    },
    "NativeConversationViewEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "enum": [
            6,
            7
          ]
        },
        "contextId": {
          "type": "string"
        },
        "subscriptionId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "view": {
          "$ref": "#/definitions/NativeConversationView"
        }
      },
      "required": [
        "schemaVersion",
        "contextId",
        "subscriptionId",
        "sessionId",
        "view"
      ]
    },
    "NativeConversationHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "views",
        "historyAvailability",
        "submissions",
        "remainingTurnIds"
      ],
      "properties": {
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NativeConversationView"
          },
          "maxItems": 50
        },
        "historyAvailability": {
          "type": "string",
          "enum": [
            "partial",
            "unavailable"
          ]
        },
        "submissions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/LocalSubmissionView"
          }
        },
        "remainingTurnIds": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string"
          }
        },
        "recordDiagnostics": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/NativeRecordDiagnostic"
          }
        }
      }
    },
    "NativeHistoryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "turnIds"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "turnIds": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "LocalSubmissionView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turnId",
        "operationId",
        "status"
      ],
      "properties": {
        "turnId": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "submitted",
            "failed",
            "uncertain",
            "cancelled"
          ]
        }
      }
    },
    "NativeRecordDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "turnId",
        "formatVersion",
        "code"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        },
        "formatVersion": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string",
          "enum": [
            "format_unsupported"
          ]
        }
      }
    },
    "NativeViewRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "views",
        "recordDiagnostics"
      ],
      "properties": {
        "views": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/NativeConversationView"
          }
        },
        "recordDiagnostics": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/NativeRecordDiagnostic"
          }
        }
      }
    },
    "NativeTraceNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "sequence",
        "method",
        "code",
        "scope"
      ],
      "properties": {
        "eventId": {
          "type": "string"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "method": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "code": {
          "type": "string",
          "maxLength": 128
        },
        "scope": {
          "type": "string",
          "enum": [
            "thread",
            "turn"
          ]
        },
        "willRetry": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "itemId": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "McpApprovalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server",
        "tool",
        "asin",
        "marketplace"
      ],
      "description": "Validated bounded parameters from the actual native Prompt request; not an authorization or Tool Item binding. Only the configured sorftime/product_detail single US ASIN is supported.",
      "properties": {
        "server": {
          "type": "string",
          "enum": [
            "sorftime"
          ]
        },
        "tool": {
          "type": "string",
          "enum": [
            "product_detail"
          ]
        },
        "asin": {
          "type": "string",
          "pattern": "^[A-Z0-9]{10}$",
          "minLength": 10,
          "maxLength": 10
        },
        "marketplace": {
          "type": "string",
          "enum": [
            "US"
          ]
        }
      }
    },
    "McpPermissionScopeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "runtimeRestarted"
      ],
      "properties": {
        "active": {
          "type": "boolean",
          "description": "Whether the scoped Sorftime configuration remains enabled. Returning to ask does not silently reactivate it."
        },
        "runtimeRestarted": {
          "type": "boolean",
          "description": "True only after normal EOF exit, cleanup and source-verified restart without Sorftime."
        }
      }
    }
  },
  "$id": ""
}
