{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NativeConversationViewV2",
  "$ref": "#/definitions/NativeConversationViewEvent",
  "definitions": {
    "NativeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "availability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 512
        },
        "type": {
          "type": "string",
          "enum": [
            "userMessage",
            "agentMessage",
            "reasoning",
            "commandExecution",
            "mcpToolCall",
            "unknown"
          ]
        },
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 1048576
        },
        "phase": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "commentary",
                "final_answer"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 1048576
          }
        },
        "content": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 1048576
          }
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "inProgress",
                "completed",
                "failed",
                "declined"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer",
              "format": "int32"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "anyOf": [
            {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "argumentsSummary": {
          "type": "string",
          "maxLength": 4096,
          "description": "Metadata display only; raw native arguments never leave Host."
        },
        "resultSummary": {
          "type": "string",
          "maxLength": 8192,
          "description": "Metadata display only, omitted when native result is absent or null."
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "unavailable"
          ],
          "description": "Completeness of this safe display projection, independent of the native execution status."
        },
        "commandLabel": {
          "type": "string",
          "maxLength": 8192,
          "description": "Security projection label, not the original command. No execution semantics are inferred."
        },
        "cwdLabel": {
          "type": "string",
          "maxLength": 1024,
          "description": "Workspace-relative display label; never the native absolute path."
        },
        "outputText": {
          "type": "string",
          "maxLength": 1048576,
          "description": "Bounded, redacted projection of native aggregatedOutput. Omitted when native output is null or unavailable."
        },
        "toolLabel": {
          "type": "string",
          "maxLength": 256,
          "description": "Safe display label, not a registered tool identifier. Tool registration is outside FEAT-132."
        },
        "mcp": {
          "$ref": "#/definitions/NativeMcpDisplay"
        }
      }
    },
    "NativeTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "items",
        "itemsComplete"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 512
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "inProgress",
                "completed",
                "interrupted",
                "failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "type": "string",
          "maxLength": 128,
          "description": "Safe diagnostic category for a native error; not the raw error payload. Native status is preserved separately."
        },
        "items": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/definitions/NativeItem"
          }
        },
        "itemsComplete": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/definitions/NativeError"
        }
      }
    },
    "NativePlanStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "status"
      ],
      "properties": {
        "step": {
          "type": "string",
          "maxLength": 65536
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "inProgress",
            "completed"
          ]
        }
      }
    },
    "NativeNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "method",
        "threadId",
        "availability"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "runtime_notification",
            "projection_notice"
          ]
        },
        "method": {
          "type": "string",
          "maxLength": 128
        },
        "threadId": {
          "type": "string",
          "maxLength": 512
        },
        "turnId": {
          "type": "string",
          "maxLength": 512
        },
        "itemId": {
          "type": "string",
          "maxLength": 512
        },
        "item": {
          "$ref": "#/definitions/NativeItem"
        },
        "turn": {
          "$ref": "#/definitions/NativeTurn"
        },
        "delta": {
          "type": "string",
          "maxLength": 1048576
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "plan": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/definitions/NativePlanStep"
          }
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string",
          "maxLength": 128
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        }
      }
    },
    "NativeThreadSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "thread_id",
        "turns",
        "availability"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [
            2
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "runtime_read",
            "runtime_resume"
          ]
        },
        "thread_id": {
          "type": "string",
          "maxLength": 512
        },
        "turns": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/definitions/NativeTurn"
          }
        },
        "availability": {
          "type": "string",
          "enum": [
            "partial",
            "unavailable"
          ]
        }
      }
    },
    "NativeEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "stream_id",
        "sequence",
        "occurred_at",
        "task_id",
        "agent_session_id",
        "codex_thread_id",
        "event_type",
        "terminal",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [
            8
          ]
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "stream_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "agent_session_id": {
          "type": "string",
          "format": "uuid"
        },
        "codex_thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": "string",
          "maxLength": 512
        },
        "item_id": {
          "type": "string",
          "maxLength": 512
        },
        "event_type": {
          "type": "string",
          "enum": [
            "native.notification"
          ]
        },
        "terminal": {
          "type": "boolean"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "native"
          ],
          "properties": {
            "native": {
              "$ref": "#/definitions/NativeNotification"
            }
          }
        }
      }
    },
    "NativeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability"
      ],
      "properties": {
        "availability": {
          "type": "string",
          "enum": [
            "partial",
            "unavailable"
          ]
        },
        "messageText": {
          "type": "string",
          "maxLength": 4096,
          "description": "Bounded redacted native message, not an inferred execution result."
        },
        "codexErrorInfo": {
          "type": "string",
          "enum": [
            "contextWindowExceeded",
            "sessionBudgetExceeded",
            "usageLimitExceeded",
            "serverOverloaded",
            "cyberPolicy",
            "httpConnectionFailed",
            "responseStreamConnectionFailed",
            "internalServerError",
            "unauthorized",
            "badRequest",
            "threadRollbackFailed",
            "sandboxError",
            "responseStreamDisconnected",
            "responseTooManyFailedAttempts",
            "activeTurnNotSteerable",
            "other"
          ],
          "description": "Allowlisted native discriminator. Unknown native details are omitted."
        }
      }
    },
    "NativeMcpText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "text"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31,
          "description": "Original native content array index; never renumber after filtering."
        },
        "text": {
          "type": "string",
          "maxLength": 262144,
          "description": "Complete native text block after existing whole-line confidentiality projection, then UTF-8 truncation. Plain text only; links remain inert."
        }
      }
    },
    "NativeMcpDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultKind",
        "texts",
        "diagnostics"
      ],
      "description": "Display-only native MCP facts. No raw arguments/error/meta/resources/structuredContent and no business field parsing. Limits do not change execution status. Host bounds total UTF-8 text at 256KiB and first 32 original content entries. Confidentiality may replace entire lines.",
      "properties": {
        "server": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "tool": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "resultKind": {
          "type": "string",
          "enum": [
            "absent",
            "null",
            "empty",
            "text",
            "unsupported",
            "omitted"
          ]
        },
        "texts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/NativeMcpText"
          }
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "identity_unavailable",
              "arguments_unavailable",
              "unsupported_content",
              "content_redacted",
              "content_truncated",
              "content_limit",
              "result_unavailable",
              "display_limit"
            ]
          }
        }
      }
    },
    "NativeDisplayItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "$ref": "#/definitions/NativeItem"
        },
        "lastMethod": {
          "type": "string",
          "enum": [
            "item/started",
            "item/completed",
            "thread/read"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "item",
        "lastMethod",
        "ordinal"
      ]
    },
    "NativeViewCursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streamId": {
          "type": "string"
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "eventId": {
          "type": "string"
        }
      },
      "required": [
        "streamId",
        "sequence",
        "eventId"
      ]
    },
    "NativeConversationView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        },
        "runtimeThreadId": {
          "type": "string"
        },
        "runtimeTurnId": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "native_observed",
            "native_rebuilt",
            "legacy_archive"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "inProgress",
                "completed",
                "interrupted",
                "failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "terminalObserved": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NativeDisplayItem"
          },
          "maxItems": 512
        },
        "plan": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NativePlanStep"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/NativeViewCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminalErrorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "statusSource": {
          "type": "string",
          "enum": [
            "runtime_notification",
            "runtime_read"
          ]
        }
      },
      "required": [
        "sessionId",
        "turnId",
        "runtimeThreadId",
        "runtimeTurnId",
        "source",
        "revision",
        "availability",
        "terminalObserved",
        "items"
      ]
    },
    "NativeConversationViewEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "enum": [
            2
          ]
        },
        "contextId": {
          "type": "string"
        },
        "subscriptionId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "view": {
          "$ref": "#/definitions/NativeConversationView"
        }
      },
      "required": [
        "schemaVersion",
        "contextId",
        "subscriptionId",
        "sessionId",
        "view"
      ]
    },
    "NativeConversationHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "views",
        "historyAvailability",
        "submissions",
        "remainingTurnIds"
      ],
      "properties": {
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NativeConversationView"
          },
          "maxItems": 50
        },
        "historyAvailability": {
          "type": "string",
          "enum": [
            "partial",
            "unavailable"
          ]
        },
        "submissions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/LocalSubmissionView"
          }
        },
        "remainingTurnIds": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string"
          }
        },
        "recordDiagnostics": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/NativeRecordDiagnostic"
          }
        }
      }
    },
    "NativeHistoryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "turnIds"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "turnIds": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "LocalSubmissionView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turnId",
        "operationId",
        "status"
      ],
      "properties": {
        "turnId": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "submitted",
            "failed",
            "uncertain",
            "cancelled"
          ]
        }
      }
    },
    "NativeRecordDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "turnId",
        "formatVersion",
        "code"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        },
        "formatVersion": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string",
          "enum": [
            "format_unsupported"
          ]
        }
      }
    },
    "NativeViewRecords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "views",
        "recordDiagnostics"
      ],
      "properties": {
        "views": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/NativeConversationView"
          }
        },
        "recordDiagnostics": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/NativeRecordDiagnostic"
          }
        }
      }
    }
  },
  "$id": ""
}
