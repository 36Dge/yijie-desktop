{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop.yijie.ai/private/chat-artifact-live-v1.schema.json",
  "title": "ChatArtifactLiveEventV1",
  "x-yijie-schema-version": 1,
  "x-yijie-event-channel": "yijie:chat:artifact:changed:v1",
  "oneOf": [
    { "$ref": "#/$defs/artifactChanged" },
    { "$ref": "#/$defs/resyncRequired" },
    { "$ref": "#/$defs/contextInvalidated" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "notificationSequence": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
      "maxLength": 20
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "subscriptionId",
        "contextId",
        "sessionId",
        "turnId",
        "eventId",
        "notificationSequence",
        "kind",
        "payload"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "subscriptionId": { "$ref": "#/$defs/uuid" },
        "contextId": { "$ref": "#/$defs/uuid" },
        "sessionId": { "$ref": "#/$defs/uuid" },
        "turnId": { "$ref": "#/$defs/uuid" },
        "eventId": { "$ref": "#/$defs/uuid" },
        "notificationSequence": { "$ref": "#/$defs/notificationSequence" },
        "kind": { "enum": ["artifact_changed", "resync_required", "context_invalidated"] },
        "payload": { "type": "object" }
      }
    },
    "artifactChanged": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "artifact_changed" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "resyncRequired": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "resync_required" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason"],
              "properties": {
                "reason": { "enum": ["backpressure", "sequence_gap", "protocol_error"] }
              }
            }
          }
        }
      ]
    },
    "contextInvalidated": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "context_invalidated" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason"],
              "properties": { "reason": { "const": "authority_changed" } }
            }
          }
        }
      ]
    }
  }
}
