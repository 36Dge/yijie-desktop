{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "com.yijie.desktop/chat-artifact-report-native-v1.schema.json",
  "title": "Yijie Desktop Private Artifact Report Native Boundary v1",
  "description": "Identity-only bounded report projection and canonical JSON save boundary.",
  "x-yijie-schema-version": 1,
  "x-yijie-command-names": [
    "chat_read_artifact_report_preview_v1",
    "chat_save_artifact_report_v1"
  ],
  "x-yijie-error-codes": [
    "artifact_native_invalid_request",
    "artifact_native_unauthenticated",
    "artifact_native_forbidden",
    "artifact_native_not_found",
    "artifact_native_not_ready",
    "artifact_native_expired",
    "artifact_native_unsupported",
    "artifact_native_integrity_failed",
    "artifact_native_limit_exceeded",
    "artifact_native_conflict",
    "artifact_native_extension_mismatch",
    "artifact_native_dialog_unavailable",
    "artifact_native_permission_denied",
    "artifact_native_storage_full",
    "artifact_native_io_failed",
    "artifact_native_unavailable"
  ],
  "x-yijie-preview-limits": {
    "sourceBytes": 4194304,
    "projectionBytes": 524288,
    "responseBytes": 1048576,
    "documentDepth": 12,
    "documentNodes": 100000,
    "sections": 64,
    "operationsPerWebview": 2,
    "sourceBytesInFlightPerWebview": 8388608,
    "timeoutSeconds": 10
  },
  "x-yijie-save-limits": {
    "sourceBytes": 67108864,
    "mediaType": "application/vnd.yijie.report+json;version=1",
    "extension": "json"
  },
  "x-yijie-command-contracts": {
    "chat_read_artifact_report_preview_v1": {
      "request": "#/$defs/identityRequest",
      "response": "#/$defs/previewResponse"
    },
    "chat_save_artifact_report_v1": {
      "request": "#/$defs/identityRequest",
      "response": "#/$defs/saveResponse"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "identityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "contextId", "payload"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "$ref": "#/$defs/uuid" },
        "contextId": { "$ref": "#/$defs/uuid" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionId", "turnId", "artifactId"],
          "properties": {
            "sessionId": { "$ref": "#/$defs/uuid" },
            "turnId": { "$ref": "#/$defs/uuid" },
            "artifactId": { "$ref": "#/$defs/uuid" }
          }
        }
      }
    },
    "commonSection": {
      "type": "object",
      "required": ["ordinal", "id", "type", "required", "truncated"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 63 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "truncated": { "type": "boolean" }
      }
    },
    "textSection": {
      "allOf": [
        { "$ref": "#/$defs/commonSection" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ordinal", "id", "type", "required", "truncated", "heading", "text"],
          "properties": {
            "ordinal": { "type": "integer", "minimum": 0, "maximum": 63 },
            "id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "type": { "enum": ["summary", "paragraph"] },
            "required": { "type": "boolean" },
            "truncated": { "type": "boolean" },
            "heading": { "type": ["string", "null"], "maxLength": 1024 },
            "text": { "type": "string", "maxLength": 8192 }
          }
        }
      ]
    },
    "metricItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "unit"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "maxLength": 128 }
          ]
        },
        "unit": { "type": ["string", "null"], "maxLength": 32 }
      }
    },
    "metricsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "id", "type", "required", "truncated", "items"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 63 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": { "const": "metrics" },
        "required": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "items": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/metricItem" } }
      }
    },
    "tableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "key", "label"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 31 },
        "key": { "type": "string", "minLength": 1, "maxLength": 64 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "tableSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "id", "type", "required", "truncated", "caption", "columns", "rows"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 63 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": { "const": "table" },
        "required": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "caption": { "type": ["string", "null"], "maxLength": 1024 },
        "columns": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/tableColumn" } },
        "rows": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "array",
            "maxItems": 32,
            "items": { "type": ["string", "number", "boolean", "null"] }
          }
        }
      }
    },
    "chartSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "name", "values"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 15 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "values": { "type": "array", "maxItems": 128, "items": { "type": "number" } }
      }
    },
    "chartSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "id", "type", "required", "truncated", "title", "chartType", "labels", "series", "aligned"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 63 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": { "const": "chart" },
        "required": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "title": { "type": ["string", "null"], "maxLength": 1024 },
        "chartType": { "enum": ["bar", "line", "pie"] },
        "labels": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 128 } },
        "series": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/chartSeries" } },
        "aligned": { "type": "boolean" }
      }
    },
    "calloutSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "id", "type", "required", "truncated", "tone", "title", "text"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 63 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": { "const": "callout" },
        "required": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "tone": { "enum": ["info", "success", "warning", "error"] },
        "title": { "type": ["string", "null"], "maxLength": 1024 },
        "text": { "type": "string", "maxLength": 8192 }
      }
    },
    "unsupportedSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "id", "type", "required", "truncated"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 63 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": { "const": "unsupported" },
        "required": { "const": false },
        "truncated": { "const": false }
      }
    },
    "section": {
      "oneOf": [
        { "$ref": "#/$defs/textSection" },
        { "$ref": "#/$defs/metricsSection" },
        { "$ref": "#/$defs/tableSection" },
        { "$ref": "#/$defs/chartSection" },
        { "$ref": "#/$defs/calloutSection" },
        { "$ref": "#/$defs/unsupportedSection" }
      ]
    },
    "previewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "title", "generatedAt", "sourceTime", "truncated", "sections"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "generatedAt": { "type": "string" },
        "sourceTime": { "type": ["string", "null"] },
        "truncated": { "type": "boolean" },
        "sections": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/section" } }
      }
    },
    "errorCode": {
      "enum": [
        "artifact_native_invalid_request", "artifact_native_unauthenticated", "artifact_native_forbidden",
        "artifact_native_not_found", "artifact_native_not_ready", "artifact_native_expired",
        "artifact_native_unsupported", "artifact_native_integrity_failed", "artifact_native_limit_exceeded",
        "artifact_native_conflict", "artifact_native_extension_mismatch", "artifact_native_dialog_unavailable",
        "artifact_native_permission_denied", "artifact_native_storage_full", "artifact_native_io_failed",
        "artifact_native_unavailable"
      ]
    },
    "saveResult": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["status", "code"],
          "properties": { "status": { "enum": ["saved", "cancelled"] }, "code": { "type": "null" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["status", "code"],
          "properties": { "status": { "const": "failed" }, "code": { "$ref": "#/$defs/errorCode" } }
        }
      ]
    },
    "previewResponse": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "requestId", "data"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "$ref": "#/$defs/uuid" },
        "data": { "$ref": "#/$defs/previewResult" }
      }
    },
    "saveResponse": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "requestId", "data"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "$ref": "#/$defs/uuid" },
        "data": { "$ref": "#/$defs/saveResult" }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "code", "retryable"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "code": { "$ref": "#/$defs/errorCode" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
