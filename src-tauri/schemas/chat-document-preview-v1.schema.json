{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "com.yijie.desktop/chat-document-preview-v1.schema.json",
  "title": "FEAT-166 scoped document presentation and original-file export",
  "x-command-names": [
    "chat_document_preview_v1"
  ],
  "x-event": "chat-document-preview-invalidated",
  "x-authority": "Existing Native context/owner/tenant and a committed artifact, bound attachment, or exact file reference in the named assistant item. Local references are read only below Desktop or the scoped session workspace.",
  "x-compatibility": "FEAT-171 adds optional layout/content selection and capability metadata. Missing mode preserves default reader behavior when document runtime is disabled. Paired source-generated UI sends mode only after Native advertises availableModes; no new command, storage migration or file authority. Preview toolbar adds save with the existing scoped source and expected revision; Native advertises optional saveSupported before the renderer sends this action. Prior actions retain their interpretation. Destinations are selected exclusively in the system save dialog; source bytes and destination paths stay in Native. Revision-bound locate now accepts stored artifacts and bound attachments after locationSupported is advertised. It returns only an existing workspace file whose bytes match the authorized document; no file is created and original messageFile locate behavior is unchanged.",
  "definitions": {
    "Source": {
      "oneOf": [
        {
          "$ref": "#/definitions/ArtifactSource"
        },
        {
          "$ref": "#/definitions/AttachmentSource"
        },
        {
          "$ref": "#/definitions/MessageFileSource"
        }
      ]
    },
    "Viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 20000
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 20000
        },
        "dpr": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 8
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height",
        "dpr"
      ]
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "zoom": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "scrollX": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "scrollY": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "revision": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "viewMode": {
          "type": "string",
          "enum": [
            "layout",
            "content"
          ],
          "description": "Optional FEAT-171 paired Native input. Defaults to layout for DOCX/PPTX and content for XLSX."
        }
      },
      "required": [
        "section",
        "offset",
        "zoom",
        "scrollX",
        "scrollY",
        "revision"
      ]
    },
    "Section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 255
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "open"
            },
            "viewId": {
              "type": "string",
              "format": "uuid"
            },
            "source": {
              "$ref": "#/definitions/Source"
            },
            "viewport": {
              "$ref": "#/definitions/Viewport"
            },
            "location": {
              "$ref": "#/definitions/Location"
            },
            "theme": {
              "enum": [
                "light",
                "dark"
              ]
            }
          },
          "required": [
            "action",
            "viewId",
            "source",
            "viewport",
            "location",
            "theme"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "resize"
            },
            "viewId": {
              "type": "string",
              "format": "uuid"
            },
            "viewport": {
              "$ref": "#/definitions/Viewport"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": [
            "action",
            "viewId",
            "viewport",
            "visible"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "position"
            },
            "viewId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "action",
            "viewId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "close"
            },
            "viewId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "action",
            "viewId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "locate"
            },
            "viewId": {
              "type": "string",
              "format": "uuid"
            },
            "source": {
              "$ref": "#/definitions/MessageFileSource"
            }
          },
          "required": [
            "action",
            "viewId",
            "source"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "save"
            },
            "viewId": {
              "type": "string",
              "format": "uuid"
            },
            "source": {
              "$ref": "#/definitions/Source"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "action",
            "viewId",
            "source",
            "revision"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "locate"
            },
            "viewId": {
              "type": "string",
              "format": "uuid"
            },
            "source": {
              "$ref": "#/definitions/StoredSource"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "action",
            "viewId",
            "source",
            "revision"
          ]
        }
      ]
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "contextId": {
          "type": "string",
          "format": "uuid"
        },
        "payload": {
          "$ref": "#/definitions/Action"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "contextId",
        "payload"
      ]
    },
    "Document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "html",
            "text",
            "docx",
            "pptx",
            "xlsx",
            "pdf",
            "image",
            "video"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Section"
          },
          "maxItems": 512
        },
        "section": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "nextOffset": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "previousOffset": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "notice": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "viewMode": {
          "type": "string",
          "enum": [
            "layout",
            "content"
          ]
        },
        "availableModes": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "layout",
              "content"
            ]
          }
        },
        "saveSupported": {
          "type": "boolean",
          "description": "Native supports saving this original document with its scoped source and revision. Absent on older readers; the renderer must not send save without this capability."
        },
        "locationSupported": {
          "type": "boolean",
          "description": "The scoped Native reader can locate a current on-disk file matching this source revision inside the authorized session workspace."
        }
      },
      "required": [
        "kind",
        "revision",
        "expiresAt",
        "sections",
        "section",
        "offset",
        "nextOffset",
        "previousOffset",
        "partial",
        "notice"
      ]
    },
    "Position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scrollX": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "scrollY": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        }
      },
      "required": [
        "scrollX",
        "scrollY"
      ]
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "resized",
            "position",
            "closed",
            "located",
            "saved",
            "cancelled"
          ]
        },
        "viewId": {
          "type": "string",
          "format": "uuid"
        },
        "document": {
          "oneOf": [
            {
              "$ref": "#/definitions/Document"
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "oneOf": [
            {
              "$ref": "#/definitions/Position"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 4096,
          "description": "Only returned by locate. The authorised absolute path for this exact message reference; no file content is read."
        }
      },
      "required": [
        "status",
        "viewId",
        "document",
        "position"
      ]
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "data": {
          "$ref": "#/definitions/Result"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "data"
      ]
    },
    "Invalidated": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewId": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "enum": [
            "expired",
            "forbidden",
            "unavailable"
          ]
        }
      },
      "required": [
        "viewId",
        "reason"
      ]
    },
    "Loaded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewId"
      ],
      "properties": {
        "viewId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "MessageFileSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "messageFile"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        },
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Complete decoded absolute or workspace-relative filesystem reference. A local file URL from an older reader is also accepted. Native independently extracts and compares whole references in the stored assistant message."
        }
      },
      "required": [
        "kind",
        "sessionId",
        "turnId",
        "itemId",
        "reference"
      ]
    },
    "ArtifactSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "turnId": {
          "type": "string",
          "format": "uuid"
        },
        "artifactId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "kind",
        "sessionId",
        "turnId",
        "artifactId"
      ]
    },
    "AttachmentSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "attachment"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "messageId": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Persisted message id when available; null for a newly accepted attachment. Native must resolve and verify its existing bound user message in this session."
        },
        "attachmentId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "kind",
        "sessionId",
        "messageId",
        "attachmentId"
      ]
    },
    "StoredSource": {
      "oneOf": [
        {
          "$ref": "#/definitions/ArtifactSource"
        },
        {
          "$ref": "#/definitions/AttachmentSource"
        }
      ]
    }
  },
  "$ref": "#/definitions/Request",
  "x-loaded-event": "chat-document-preview-loaded"
}
