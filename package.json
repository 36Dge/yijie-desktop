{
  "name": "yijie-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0 && vue-tsc --noEmit",
    "test": "pnpm test:demo-fast",
    "test:demo-fast": "pnpm generate:check && vitest run --maxWorkers=4 --exclude '**/.contracts-source/**' --exclude '**/.local/**' --exclude 'scripts/check-feat128-s10d-h.test.mjs'",
    "test:production-hardened": "pnpm generate:check && vitest run --maxWorkers=4 --exclude '**/.contracts-source/**' --exclude '**/.local/**'",
    "generate": "node scripts/generate-public-api.mjs && node scripts/check-agent-host-contract.mjs && node scripts/check-agent-host-v3-contract.mjs && node scripts/check-agent-host-skills-contract.mjs",
    "generate:check": "node scripts/generate-public-api.mjs --check && node scripts/check-agent-host-contract.mjs --check && node scripts/check-agent-host-v3-contract.mjs && node scripts/check-agent-host-skills-contract.mjs",
    "skills:sync:local": "node scripts/sync-desktop-skill-resources.mjs",
    "skills:check:local": "node scripts/sync-desktop-skill-resources.mjs --check --skip-package",
    "skills:release-boundary": "node scripts/check-desktop-skill-release-boundary.mjs",
    "preview": "vite preview",
    "docs:dev": "pnpm --dir docs/design docs:dev",
    "docs:build": "pnpm --dir docs/design docs:build",
    "docs:preview": "pnpm --dir docs/design docs:preview",
    "tauri:dev": "./scripts/run-local-demo-fast.sh",
    "tauri:dev:raw": "tauri dev",
    "tauri:demo-fast": "./scripts/run-local-demo-fast.sh",
    "tauri:build": "node scripts/run-tauri-build.mjs",
    "tauri:build:demo-fast": "pnpm skills:sync:local && VITE_YIJIE_ENV=local VITE_YIJIE_LOCAL_PROFILE=demo_fast VITE_YIJIE_CHAT_LOCAL_UI_ENABLED=true VITE_YIJIE_AUTHORITATIVE_PERMISSION_UI_ENABLED=true VITE_YIJIE_LOCAL_WHITELIST_LOGIN_ENABLED=false tauri build --debug --bundles app --no-sign --config src-tauri/tauri.demo-fast.conf.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/vue": "1.27.0",
    "@tauri-apps/api": "^2",
    "echarts": "6.1.0",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "2.4.11",
    "ajv": "8.17.1",
    "axe-core": "4.10.3",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "happy-dom": "20.11.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "^8.1.3",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.6"
  }
}
