{
  "name": "yijie-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0 && vue-tsc --noEmit",
    "test": "pnpm generate:check && vitest run --exclude '**/.contracts-source/**'",
    "generate": "node scripts/generate-public-api.mjs",
    "generate:check": "node scripts/generate-public-api.mjs --check",
    "preview": "vite preview",
    "docs:dev": "pnpm --dir docs/design docs:dev",
    "docs:build": "pnpm --dir docs/design docs:build",
    "docs:preview": "pnpm --dir docs/design docs:preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/vue": "1.27.0",
    "@tauri-apps/api": "^2",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "2.4.11",
    "axe-core": "4.10.3",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "happy-dom": "20.11.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "^8.1.3",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.6"
  }
}
