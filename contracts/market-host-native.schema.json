{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yijie.ai/market-host/v1/native",
  "$defs": {
    "NativeObserveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "contextId",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "contextId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "payload": {
          "$ref": "#/$defs/NativeObservePayload"
        }
      }
    },
    "NativeObserveResponse": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "requestId",
        "data"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "data": {
          "$ref": "#/$defs/NativeObservation"
        }
      }
    },
    "NativeApprovalDecideRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "contextId",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "contextId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "payload": {
          "$ref": "#/$defs/NativeApprovalDecidePayload"
        }
      }
    },
    "NativeApprovalDecideResponse": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "requestId",
        "data"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "data": {
          "$ref": "#/$defs/MarketApproval"
        }
      }
    },
    "NativeRememberedRulesRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "contextId",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "contextId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "payload": {
          "$ref": "#/$defs/NativeRememberedRulesPayload"
        }
      }
    },
    "NativeRememberedRulesResponse": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "requestId",
        "data"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "data": {
          "$ref": "#/$defs/RememberedToolRules"
        }
      }
    },
    "NativeError": {
      "$ref": "#/$defs/Error"
    },
    "CanonicalId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "NativeObservePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "nativeTurnId": {
          "$ref": "#/$defs/NativeId"
        },
        "toolsRead": {
          "$ref": "#/$defs/ToolsReadMode"
        }
      }
    },
    "NativeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ToolsReadMode": {
      "type": "string",
      "enum": [
        "none",
        "events",
        "history"
      ],
      "description": "none reads approvals/local facts only; events uses a bounded projection of real native notifications, seeding a missing snapshot from native history; history explicitly refreshes native history. Omission retains history behavior. No mode dispatches tools."
    },
    "NativeObservation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "managed",
        "selectionDisplay"
      ],
      "properties": {
        "managed": {
          "type": "boolean"
        },
        "selectionDisplay": {
          "type": "array",
          "maxItems": 58,
          "items": {
            "$ref": "#/$defs/SelectionDisplay"
          }
        },
        "approvals": {
          "$ref": "#/$defs/ApprovalSnapshot"
        },
        "tools": {
          "$ref": "#/$defs/ToolSnapshot"
        },
        "availableTurns": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/ObservedTurn"
          }
        },
        "turnsTruncated": {
          "type": "boolean"
        },
        "decisionFacts": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/DecisionFact"
          }
        },
        "decisionFactsTruncated": {
          "type": "boolean"
        },
        "remoteIssue": {
          "$ref": "#/$defs/ErrorCode"
        }
      },
      "description": "Safe scoped Native observation. Optional availableTurns is the latest 128 known native bindings in descending submission order, each with its original selectionDisplay; turnsTruncated reports older bindings omitted from the index. A known requested nativeTurnId is read with its own display snapshot, never the latest selection. Without a current Host, omit remote facts without starting/probing/reconstructing authority. With a current owned Host, historical tool reads validate scope/agent/thread/turn, not the original Host nonce. Approvals always require the current Host nonce. Current remote read failures stay typed errors. Recheck task.read and local view after awaits. Unmanaged sessions need no Host access. Old producers may omit the new index, and old readers may ignore it. No history read restores execution or approval. Optional decisionFacts are original selected-turn read-only Native evidence, available without Host. They do not populate actionable approvals. toolsRead=none omits tools and must not clear previously observed UI tool facts; events consumes notification-derived snapshots; history preserves explicit read/recovery behavior. With an explicit toolsRead mode, unavailable or invalid remote observations are omitted with remoteIssue while scoped local decisionFacts remain readable. This cannot make historical decisions actionable. Legacy omitted toolsRead retains its existing typed remote-error behavior. Active observations prioritize facts for exact currently pending approval/call identities when the history window is truncated. Historical facts otherwise follow append order; observedAtUnixMs is a captured wall-clock value, never an ordering or permission authority."
    },
    "SelectionDisplay": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "reference",
        "serviceId",
        "displayName"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/SelectionRef"
        },
        "serviceId": {
          "$ref": "#/$defs/ServiceId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "description": "Safe display snapshot only, not a turn grant; old history cannot restore authority."
    },
    "SelectionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installationId",
        "revision",
        "generation"
      ],
      "properties": {
        "installationId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "generation": {
          "$ref": "#/$defs/Revision"
        }
      },
      "description": "No service label or secret is accepted as authority. Native and Host revalidate exact scope, generation, ready state and connector.use before a versioned turn is admitted."
    },
    "Revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ServiceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "description": "Original case-sensitive catalog serverName. Syntactic acceptance does not replace exact registry lookup."
    },
    "ApprovalSnapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "agentSessionId",
        "requests"
      ],
      "properties": {
        "agentSessionId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "requests": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/MarketApproval"
          }
        }
      }
    },
    "MarketApproval": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "approvalId",
        "agentSessionId",
        "kind",
        "revision",
        "state",
        "identity",
        "review",
        "expiresAtUnixMs"
      ],
      "properties": {
        "approvalId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "agentSessionId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "kind": {
          "type": "string",
          "const": "mcp_market"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "state": {
          "$ref": "#/$defs/ApprovalState"
        },
        "identity": {
          "$ref": "#/$defs/CallIdentity"
        },
        "review": {
          "$ref": "#/$defs/ReviewProjection"
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "decisionId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "decisionExpiresAtUnixMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "executionExpiresAtUnixMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "persistOptions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "session",
              "always"
            ]
          }
        },
        "appliedPersist": {
          "type": "string",
          "enum": [
            "session",
            "always",
            "unavailable"
          ]
        }
      },
      "description": "Independent market approval projection. identity is obtained by trusted Broker query for the real tools/call; never synthesized from metadata/tool title/last Item. Approval state is not provider execution success. New web modes project paired deadlines from Broker. expiresAtUnixMs keeps execution deadline; pending UI/decision uses decisionExpiresAtUnixMs when present, otherwise legacy expiresAtUnixMs. No post-approval extension.",
      "dependentRequired": {
        "decisionExpiresAtUnixMs": [
          "executionExpiresAtUnixMs"
        ],
        "executionExpiresAtUnixMs": [
          "decisionExpiresAtUnixMs"
        ]
      }
    },
    "ApprovalState": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled",
        "expired",
        "unavailable"
      ]
    },
    "CallIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "nativeTurnId",
        "callRef",
        "serviceId",
        "reference",
        "toolName",
        "argsDigest",
        "argsEncoding",
        "nativeThreadId"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/CapabilityBinding"
        },
        "nativeTurnId": {
          "$ref": "#/$defs/NativeId"
        },
        "callRef": {
          "$ref": "#/$defs/CanonicalId"
        },
        "serviceId": {
          "$ref": "#/$defs/ServiceId"
        },
        "reference": {
          "$ref": "#/$defs/SelectionRef"
        },
        "toolName": {
          "$ref": "#/$defs/ToolName"
        },
        "argsDigest": {
          "$ref": "#/$defs/ArgsDigest"
        },
        "argsEncoding": {
          "type": "string",
          "const": "worker-json-v1"
        },
        "nativeThreadId": {
          "$ref": "#/$defs/NativeId"
        }
      },
      "description": "Created only by the Broker from a real admitted tools/call and frozen parsed argument snapshot. Native MCP request IDs and Tool Item IDs are not this identity. Query/decision do not create records; metadata merely locates an existing record."
    },
    "CapabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "capabilityRef",
        "turnOperationId",
        "selectionDigest"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/ContextBinding"
        },
        "capabilityRef": {
          "$ref": "#/$defs/CanonicalId"
        },
        "turnOperationId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "selectionDigest": {
          "$ref": "#/$defs/SelectionDigest"
        }
      },
      "description": "Non-secret immutable association. capabilityRef cannot authenticate any request or create a grant. Bind to one original actual turn operation, context and selection digest for the whole lifetime."
    },
    "ContextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process",
        "scope",
        "agentSessionId",
        "nativeThreadId"
      ],
      "properties": {
        "process": {
          "$ref": "#/$defs/ProcessBinding"
        },
        "scope": {
          "$ref": "#/$defs/ScopeBinding"
        },
        "agentSessionId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "nativeThreadId": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Immutable prepare intent: nativeThreadId is required. Null explicitly means a new not-yet-created thread; non-null is an existing actual thread. Never use a fabricated thread identifier or a model bootstrap Turn. bind_turn later freezes the actual thread and Turn together without rewriting this context."
    },
    "ProcessBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostInstanceId",
        "runtimeGeneration"
      ],
      "properties": {
        "hostInstanceId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "runtimeGeneration": {
          "$ref": "#/$defs/CanonicalId"
        }
      },
      "description": "Set once by the Host-owned process assembly. Never accept these values from Runtime, renderer or MCP metadata as proof of ownership."
    },
    "ScopeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerUserId",
        "tenantId",
        "nativeProcessEpoch",
        "authorizationRevision",
        "authorizationExpiresAtUnixMs"
      ],
      "properties": {
        "ownerUserId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "tenantId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "nativeProcessEpoch": {
          "$ref": "#/$defs/CanonicalId"
        },
        "authorizationRevision": {
          "$ref": "#/$defs/Revision"
        },
        "authorizationExpiresAtUnixMs": {
          "$ref": "#/$defs/UnixMilliseconds"
        }
      },
      "description": "Trusted Native authorization projection after Host verification; process epoch/revision are fences, not bearer credentials. Native adapter is not yet exposed to the versioned Host provider. A structurally valid JSON object alone does not authorize a product request."
    },
    "UnixMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "SelectionDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ToolName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ArgsDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ReviewProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "risk"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "risk": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "argumentsJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16384,
          "description": "Complete frozen generic-tool arguments encoded as JSON, never truncated or changed. No credentials. Render as inert text; display is not execution authority."
        },
        "schemaDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "Exact call review. Legacy reviewed tools use title/summary/risk. generic-mcp-v1 additionally requires complete credential-free argumentsJson and the frozen input schema digest, shown as inert text; unreviewable, oversized or credential-bearing inputs are denied. Undeclared read semantics uses risk=write and explicit high-risk warning. Never infer approval from tool annotations, names or OAuth consent."
    },
    "Decision": {
      "type": "string",
      "enum": [
        "approve_once",
        "reject",
        "cancel",
        "approve_session",
        "approve_always",
        "native_full",
        "native_auto",
        "native_session",
        "native_always",
        "native_auto_reject",
        "native_runtime",
        "native_runtime_reject"
      ],
      "description": "Per-call owner decision. approve_* are explicit human choices; native_* record the correlated Codex policy decision and are not renderer actions."
    },
    "ToolSnapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "agentSessionId",
        "nativeTurnId",
        "items",
        "truncated"
      ],
      "properties": {
        "agentSessionId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "nativeTurnId": {
          "$ref": "#/$defs/NativeId"
        },
        "items": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/ToolObservation"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "ToolObservation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "nativeItemId",
        "nativeThreadId",
        "nativeTurnId",
        "serverName",
        "toolName",
        "state",
        "truncated"
      ],
      "properties": {
        "nativeItemId": {
          "$ref": "#/$defs/NativeId"
        },
        "nativeThreadId": {
          "$ref": "#/$defs/NativeId"
        },
        "nativeTurnId": {
          "$ref": "#/$defs/NativeId"
        },
        "serverName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "toolName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "enum": [
            "in_progress",
            "completed",
            "failed"
          ]
        },
        "service": {
          "$ref": "#/$defs/ServiceBinding"
        },
        "callRef": {
          "$ref": "#/$defs/CanonicalId"
        },
        "resultText": {
          "type": "string",
          "maxLength": 65536
        },
        "errorCode": {
          "type": "string",
          "enum": [
            "tool_failed",
            "cancelled",
            "runtime_unavailable",
            "unsupported_result"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "correlation": {
          "$ref": "#/$defs/GatewayCallReceipt"
        },
        "resultTextSource": {
          "$ref": "#/$defs/ResultTextSource"
        },
        "structuredResultText": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "description": "Minimal observation from actual native MCP Tool Item facts. Optional service/callRef require explicit trusted correlation; never guess matching Item by latest item, same tool or args. resultText is safe bounded text from actual native output, never raw platform credentials/transport/config. Approval acceptance is not result completion. failed is an unsuccessful native tool observation, not proof that a provider request was sent, not sent or executed. Fixed Gateway error text may distinguish known pre-dispatch rejection from unverified outcome; do not infer this distinction from a generic code or guess callRef linkage. Optional correlation is the bounded Gateway-owned native result metadata. callRef must equal correlation.callRef; thread/turn/tool must match the containing Item and Native must verify the original selection/reference. Unknown/invalid metadata is omitted without losing native facts. service retains its old ProviderBinding type; correlation never contains credentialRef. Read-only decision and admission facts cannot authorize execution or imply provider success. Result text is a common bounded/redacted projection of native content and structuredContent, shared by native notifications and history. Structured-only results use resultText with resultTextSource=structured; different structured JSON is retained in structuredResultText. Identical JSON copies are not duplicated. Combined display bytes stay within maxResultTextBytes; truncated marks actual omitted/truncated content, never merely a second representation."
    },
    "ServiceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "serviceId",
        "credentialRef"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/SelectionRef"
        },
        "serviceId": {
          "$ref": "#/$defs/ServiceId"
        },
        "credentialRef": {
          "$ref": "#/$defs/CanonicalId"
        }
      },
      "description": "Native-created non-secret credential reference for the exact installation generation and revision. Keyring alias derives stable owner/tenant/service/installation/generation/credentialRef, excludes Native process epoch and display revision. Native authoritative probe may advance only the same generation revision; never treat a ready flag or OAuth completion as tool qualification."
    },
    "GatewayCallReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "callRef",
        "serviceId",
        "reference",
        "nativeThreadId",
        "nativeTurnId",
        "turnOperationId",
        "selectionDigest",
        "toolName",
        "argsDigest",
        "argsEncoding",
        "decisionReceipt",
        "admissionConsumed"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "callRef": {
          "$ref": "#/$defs/CanonicalId"
        },
        "serviceId": {
          "$ref": "#/$defs/ServiceId"
        },
        "reference": {
          "$ref": "#/$defs/SelectionRef"
        },
        "nativeThreadId": {
          "$ref": "#/$defs/NativeId"
        },
        "nativeTurnId": {
          "$ref": "#/$defs/NativeId"
        },
        "turnOperationId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "selectionDigest": {
          "$ref": "#/$defs/SelectionDigest"
        },
        "toolName": {
          "$ref": "#/$defs/ToolName"
        },
        "argsDigest": {
          "$ref": "#/$defs/ArgsDigest"
        },
        "argsEncoding": {
          "type": "string",
          "const": "worker-json-v1"
        },
        "decisionReceipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/GatewayDecisionReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "admissionConsumed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "admissionConsumed": {
                "const": true
              }
            },
            "required": [
              "admissionConsumed"
            ]
          },
          "then": {
            "properties": {
              "decisionReceipt": {
                "allOf": [
                  {
                    "$ref": "#/$defs/GatewayDecisionReceipt"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "decision": {
                        "enum": [
                          "approve_once",
                          "approve_session",
                          "approve_always",
                          "native_full",
                          "native_auto",
                          "native_session",
                          "native_always"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "description": "Gateway-owned result _meta[yijie.market.call], not supplier metadata. Capture the current frozen call and accepted decision atomically with admission. Null decisionReceipt means no accepted owner decision observed, not that no prompt occurred. admissionConsumed is only permission consumption, never HTTP delivery or provider success. Native Item identity/status remain authoritative. No credentialRef, capabilityRef, bearer, raw arguments or authority context."
    },
    "GatewayDecisionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "decisionId",
        "decision"
      ],
      "properties": {
        "approvalId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "decisionId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        }
      },
      "description": "Read-only copy of the exact owner decision already accepted by decide_call. Never an approval capability."
    },
    "ResultTextSource": {
      "type": "string",
      "enum": [
        "content",
        "structured"
      ]
    },
    "ObservedTurn": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "nativeTurnId",
        "selectionDisplay"
      ],
      "properties": {
        "nativeTurnId": {
          "$ref": "#/$defs/NativeId"
        },
        "selectionDisplay": {
          "type": "array",
          "maxItems": 58,
          "items": {
            "$ref": "#/$defs/SelectionDisplay"
          }
        }
      },
      "description": "Read-only original turn identity and submitted display snapshot. Never an approval or execution grant."
    },
    "DecisionFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "decisionId",
        "callRef",
        "serviceId",
        "reference",
        "nativeThreadId",
        "nativeTurnId",
        "turnOperationId",
        "selectionDigest",
        "toolName",
        "argsDigest",
        "decision",
        "kind",
        "schemaVersion",
        "argsEncoding",
        "observedAtUnixMs"
      ],
      "properties": {
        "approvalId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "decisionId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "callRef": {
          "$ref": "#/$defs/CanonicalId"
        },
        "serviceId": {
          "$ref": "#/$defs/ServiceId"
        },
        "reference": {
          "$ref": "#/$defs/SelectionRef"
        },
        "nativeThreadId": {
          "$ref": "#/$defs/NativeId"
        },
        "nativeTurnId": {
          "$ref": "#/$defs/NativeId"
        },
        "turnOperationId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "selectionDigest": {
          "$ref": "#/$defs/SelectionDigest"
        },
        "toolName": {
          "$ref": "#/$defs/ToolName"
        },
        "argsDigest": {
          "$ref": "#/$defs/ArgsDigest"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "kind": {
          "$ref": "#/$defs/DecisionFactKind"
        },
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "argsEncoding": {
          "type": "string",
          "const": "worker-json-v1"
        },
        "observedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "description": "Append-only read-only Native decision evidence in the existing scoped conversation database. requested is durable user intent before delivery, acknowledged is an exact validated Host reply, unconfirmed is absence of a verified reply. None proves permit consumption, tool completion or business success. Contains no authority/capability/credential references or raw parameters; never queued, replayed or used to restore approval."
    },
    "DecisionFactKind": {
      "type": "string",
      "enum": [
        "requested",
        "acknowledged",
        "unconfirmed"
      ]
    },
    "ErrorCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "invalid_request",
            "not_ready",
            "authority_mismatch",
            "scope_expired",
            "permission_denied",
            "grant_not_found",
            "grant_expired",
            "capacity_exceeded",
            "request_conflict",
            "revision_conflict",
            "selection_stale",
            "execution_unavailable",
            "model_unavailable",
            "permission_mode_unavailable",
            "session_not_found",
            "busy",
            "operation_uncertain",
            "approval_not_found",
            "approval_stale",
            "approval_expired",
            "approval_resolved",
            "cleanup_pending",
            "temporarily_unavailable",
            "context_invalid"
          ]
        },
        {
          "$ref": "#/$defs/ReferencedErrorCode"
        }
      ],
      "description": "Safe Host-specific errors plus the exact referenced provider error set. Provider error codes are not copied or independently widened."
    },
    "ReferencedErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "authority_mismatch",
        "scope_expired",
        "binding_mismatch",
        "not_found",
        "request_conflict",
        "capacity_exceeded",
        "unknown_service",
        "unsupported_auth",
        "keyring_unavailable",
        "metadata_unavailable",
        "authorization_rejected",
        "authorization_timeout",
        "not_qualified",
        "cleanup_pending",
        "temporarily_unavailable",
        "not_configured"
      ]
    },
    "NativeApprovalDecidePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "approvalId",
        "decisionId",
        "expectedRevision",
        "decision"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "approvalId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "decisionId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "expectedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        }
      },
      "not": {
        "properties": {
          "decision": {
            "enum": [
              "native_auto",
              "native_auto_reject",
              "native_full",
              "native_session",
              "native_always",
              "native_runtime",
              "native_runtime_reject"
            ]
          }
        },
        "required": [
          "decision"
        ]
      }
    },
    "NativeRememberedRulesPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/SelectionRef"
        },
        "revoke": {
          "$ref": "#/$defs/ArgsDigest"
        },
        "after": {
          "$ref": "#/$defs/ArgsDigest"
        }
      }
    },
    "RememberedToolRules": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/RememberedToolRule"
          }
        },
        "next": {
          "$ref": "#/$defs/ArgsDigest"
        }
      }
    },
    "RememberedToolRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "tool"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/ArgsDigest"
        },
        "tool": {
          "$ref": "#/$defs/ToolName"
        }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "code",
        "retryable"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/CanonicalId"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "retryable": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
